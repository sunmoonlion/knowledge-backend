SERVICE_NAME=tpl-admin-backend
ENVIRONMENT=dev
TARGET_MODE=k8s
DB_ENGINE=postgresql

# DB_HOST / OUTPUT_NAMESPACE 由 setup-k8s-db-access.sh 按 APP_NAMESPACE、DATA_NAMESPACE 在运行时解析
DB_HOST=postgresql-sunmoonai.data-platform-dev.svc.cluster.local
DB_PORT=5432
APP_DB_NAME=tpl_admin
APP_DB_USER=tpl_admin_user
APP_DB_PASSWORD=Po!s1359

PG_ADMIN_USER=postgres
PG_ADMIN_PASSWORD=Po!s1359admin
PG_ADMIN_DB=postgres
PG_SSLMODE=prefer

# OUTPUT_NAMESPACE 由 setup-k8s-db-access.sh 在运行时写入
OUTPUT_NAMESPACE=app-platform-dev
OUTPUT_SECRET_NAME=tpl-admin-backend-postgresql-conn
