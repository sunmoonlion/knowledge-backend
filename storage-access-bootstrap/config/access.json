{
  "apiVersion": "storage.sunmoonai.com/v1alpha1",
  "kind": "ObjectStorageAccess",
  "metadata": {
    "name": "knowledge-admin-backend"
  },
  "spec": {
    "provider": "platform-s3",
    "environment": "development",
    "app": "knowledge-app",
    "backend": "knowledge-admin-backend",
    "namespace": "app-platform-dev",
    "secretName": "knowledge-admin-backend-s3",
    "configMapName": "knowledge-admin-backend-s3",
    "region": "us-east-1",
    "forcePathStyle": true,
    "useTLS": false,
    "deletionPolicy": "Retain",
    "buckets": [
      {
        "name": "development-info-originals",
        "permissions": ["read"],
        "versioning": true,
        "objectLock": false
      },
      {
        "name": "development-knowledge-admin-assets",
        "permissions": ["read", "write", "delete", "list"],
        "versioning": true,
        "objectLock": false
      }
    ]
  }
}
