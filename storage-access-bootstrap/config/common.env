# Object storage access bootstrap configuration (admin-backend).
#
# Backend 模板默认具备完整对象存储能力。具体业务数据归属在功能实现时遵守
# 唯一写入原则，是否部署该 Backend 由 K8s 集群配置决定。
ENABLE_OBJECT_STORAGE=true

OBJECT_STORAGE_CLUSTER="${OBJECT_STORAGE_CLUSTER:-${CLUSTER:-KIND}}"
OBJECT_STORAGE_DECLARATION="${OBJECT_STORAGE_DECLARATION:-${SCRIPT_DIR}/config/access.json}"

if [[ -z "${OBJECT_STORAGE_PROVISIONER_BIN:-}" ]]; then
  OBJECT_STORAGE_PROVISIONER_BIN="${SUNMOONAI_K8S_ROOT:-${HOME}/k8s}/sunmoonai/data-platform/object-storage/provisioner/object-storage-provisioner.sh"
fi
