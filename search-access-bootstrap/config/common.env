ENABLE_SEARCH_ACCESS=true

ELASTICSEARCH_CLUSTER="${ELASTICSEARCH_CLUSTER:-${CLUSTER:-KIND}}"
ELASTICSEARCH_DECLARATION="${ELASTICSEARCH_DECLARATION:-${SCRIPT_DIR}/config/access.json}"

if [[ -z "${ELASTICSEARCH_PROVISIONER_BIN:-}" ]]; then
  ELASTICSEARCH_PROVISIONER_BIN="${SUNMOONAI_K8S_ROOT:-${HOME}/k8s}/sunmoonai/data-platform/elasticsearch/provisioner/elasticsearch-provisioner.sh"
fi
