# 基础配置
ENV=development
LOG_LEVEL=INFO

# 数据库（可由 db-access-bootstrap merge-and-generate-app-env.sh 写入；+asyncpg 由 config.py 自动补）
DATABASE_URL=postgresql://knowledge:knowledge@localhost:5432/knowledge

# Redis（dbctl ACL 用户时设置 REDIS_USER；仅 default 用户可省略）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_USER=
REDIS_PASSWORD=

# S3 object storage (由 storage-access-bootstrap 在 k8s 中注入)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_BUCKETS=
S3_FORCE_PATH_STYLE=true
S3_USE_TLS=false

# Elasticsearch（由 search-access-bootstrap 在 k8s 中注入）
ELASTICSEARCH_URL=https://localhost:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_CA_CERT=/var/run/secrets/sunmoonai/elasticsearch/ca.crt
ELASTICSEARCH_READ_ALIASES=
ELASTICSEARCH_WRITE_ALIASES=

# Casdoor BFF
CASDOOR_ENDPOINT=https://casdoor.example.com
CASDOOR_CLIENT_ID=your_client_id
CASDOOR_CLIENT_SECRET=your_client_secret
CASDOOR_REDIRECT_URI=http://localhost:8001/api/auth/callback
CASDOOR_ORGANIZATION=built-in
CASDOOR_APPLICATION=sunmoonai-knowledge-admin
# Optional explicit discovery URL; when omitted it is derived from the application name.
# CASDOOR_DISCOVERY_URL=https://casdoor.example.com/.well-known/sunmoonai-knowledge-admin/openid-configuration

AUTH_HTTP_TIMEOUT_SECONDS=10
AUTH_TRANSACTION_TTL_SECONDS=300
AUTH_DISCOVERY_CACHE_SECONDS=300
AUTH_JWKS_CACHE_SECONDS=300
AUTH_CLOCK_SKEW_SECONDS=30
AUTH_ALLOWED_ALGORITHMS=RS256,ES256
AUTH_POLICY_VERSION=knowledge-admin-v1
SESSION_COOKIE_SECURE=false
FRONTEND_ALLOWED_ORIGINS=http://localhost:5173

SESSION_TTL_SECONDS=3600

FRONTEND_BASE_URL=http://localhost:5173
CASDOOR_VERIFY_SSL=true

# Celery（可选；k8s 中 CELERY_BROKER_URL 在 Secret，CELERY_QUEUE 在 ConfigMap）
# CELERY_BROKER_URL=amqp://tpl-admin-backend-producer:pass@localhost:5672/tpl-development
# CELERY_QUEUE=tpl.admin.default

# RAGFlow ingestion（未配置时只做真实 artifact 校验，不伪造成功）
RAGFLOW_API_BASE=http://ragflow:9380
RAGFLOW_API_KEY=
RAGFLOW_PARSE_TIMEOUT_SECONDS=120
RAGFLOW_PARSE_POLL_INTERVAL_SECONDS=1.0
