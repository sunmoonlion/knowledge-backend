# 基础配置
ENV=development
LOG_LEVEL=INFO

# 数据库（可由 db-access-bootstrap merge-and-generate-app-env.sh 写入；+asyncpg 由 config.py 自动补）
DATABASE_URL=postgresql://tpl:tpl@localhost:5432/tpl

# Redis（dbctl ACL 用户时设置 REDIS_USER；仅 default 用户可省略）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_USER=
REDIS_PASSWORD=

# Casdoor BFF
CASDOOR_ENDPOINT=https://casdoor.example.com
CASDOOR_CLIENT_ID=your_client_id
CASDOOR_CLIENT_SECRET=your_client_secret
CASDOOR_REDIRECT_URI=http://localhost:8001/api/auth/callback
CASDOOR_ORGANIZATION=built-in
CASDOOR_APPLICATION=app-tpl-admin

SESSION_TTL_SECONDS=3600

FRONTEND_BASE_URL=http://localhost:5173
CASDOOR_VERIFY_SSL=true

# Celery（可选；k8s 中 CELERY_BROKER_URL 在 Secret，CELERY_QUEUE 在 ConfigMap）
# CELERY_BROKER_URL=amqp://tpl-admin-backend-producer:pass@localhost:5672/tpl-development
# CELERY_QUEUE=tpl.admin.default
